---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/courses/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ site.url }}/llms.txt</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site.url }}/discussion/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.6</priority>
  </url>
  {%- for course in coursesList -%}
  {%- set docStory = materialHelpers.getDoc(course, 'story') -%}
  {%- set hasPhotos = materialHelpers.hasMaterial(course, 'photos') -%}
  {%- set hasBlackboard = materialHelpers.hasMaterial(course, 'blackboard') -%}
  {%- set hasSheetMusic = materialHelpers.hasMaterial(course, 'sheet_music') -%}
  {%- set hasVideos = materialHelpers.hasMaterial(course, 'videos') -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- if docStory -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/story/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endif -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/play-script/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/workbook/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- if hasPhotos -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/photos/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endif -%}
  {%- if hasBlackboard -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/blackboard/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endif -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/scripts/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/songs/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- if hasSheetMusic -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/sheet-music/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endif -%}
  {%- if hasVideos -%}
  <url>
    <loc>{{ site.url }}/courses/{{ course.slug }}/videos/</loc>
    <lastmod>{{ buildTime }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endif -%}
  {%- endfor -%}
</urlset>
